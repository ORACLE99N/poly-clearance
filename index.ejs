<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Ogbonnaya Onu Polytechnic - Clearance Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="text-start">
                <h1 class="fw-bold text-primary">Ogbonnaya Onu Polytechnic</h1>
                <h4 class="text-muted">Digital Student Clearance Portal</h4>
            </div>
            <div class="text-end">
                <img src="/logo-polo.jpeg" alt="Poly Logo" class="img-fluid" style="max-height: 80px;">
            </div>
        </div>

        <% if (message) { %>
            <div class="alert alert-warning text-center"><%= message %></div>
        <% } %>

        <div class="row g-4">
            <!-- Student Authentication Box -->
            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body p-4">
                        <h3 class="card-title text-success mb-3">Student Hub</h3>
                        <form action="/student/auth" method="POST">
                            <div class="mb-3">
                                <label class="form-label">Matriculation Number</label>
                                <input type="text" name="matric" class="form-control" placeholder="e.g. ND2024/22585/1/CS" required>
                                <div class="form-text">Format: ND2024/.../CS or HND2023/.../BA</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Password</label>
                                <input type="password" name="password" class="form-control" placeholder="Choose a password" required>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" name="action" value="login" class="btn btn-outline-success w-50">Login</button>
                                <button type="submit" name="action" value="register" class="btn btn-success w-50">Register Account</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Admin Authentication Box -->
            <div class="col-md-6">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body p-4">
                        <h3 class="card-title text-primary mb-3">Administrative Staff Login</h3>
                        <form action="/admin/login" method="POST">
                            <div class="mb-3">
                                <label class="form-label">Select Department / Unit Office</label>
                                <select name="adminUnit" class="form-select" required>
                                    <optgroup label="Central Offices">
                                        <% units.forEach(unit => { %>
                                            <option value="<%= unit %>"><%= unit %> Office</option>
                                        <% }) %>
                                    </optgroup>
                                    <optgroup label="Academic Departments">
                                        <% departments.forEach(dept => { %>
                                            <option value="<%= dept.short %>"><%= dept.name %> (<%= dept.short %>)</option>
                                        <% }) %>
                                    </optgroup>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Security Access Key</label>
                                <input type="password" name="password" class="form-control" placeholder="Enter administrative password" required>
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Authenticate Access</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
