<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Student Clearance Status</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Welcome Student!</h2>
                <p class="text-muted mb-0">Matric: <strong><%= student.matric %></strong> | Department Tracker: <strong><%= student.deptShort %></strong></p>
            </div>
            <div class="text-end d-flex flex-column align-items-end gap-2">
                <img src="/logo-polo.jpeg" alt="Poly Logo" class="img-fluid" style="max-height: 80px;">
                <a href="/logout" class="btn btn-danger btn-sm">Secure Sign Out</a>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h4 class="mb-4">Your Mandatory Clearance Parameters</h4>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Clearance Checkpoint</th>
                                <th>Status Designation</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% Object.keys(student.clearances).forEach(unit => { %>
                                <tr>
                                    <td>
                                        <strong><%= unit %></strong>
                                        <% if(unit === 'Department') { %> (<%= student.deptShort %> Office)<% } %>
                                    </td>
                                    <td>
                                        <% if(student.clearances[unit] === 'Cleared') { %>
                                            <span class="badge bg-success px-3 py-2">✅ Cleared</span>
                                        <% } else if(student.clearances[unit] === 'Rejected') { %>
                                            <span class="badge bg-danger px-3 py-2">❌ Denied / Outstanding Issue</span>
                                        <% } else { %>
                                            <span class="badge bg-warning text-dark px-3 py-2">⏳ System Pending Review</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>